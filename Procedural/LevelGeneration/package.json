{
  "name": "level-generation-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.core.json && tsc --project tsconfig.porting.json",
    "port:export": "node tools/porting/export.mjs",
    "test": "vitest run tests",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:e2e": "npm run build && playwright test --grep-invert @measure",
    "measure": "npm run build && playwright test --grep @measure",
    "measure:urban": "vitest run experiments/urban-generation.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "three": "0.186.0"
  }
}
