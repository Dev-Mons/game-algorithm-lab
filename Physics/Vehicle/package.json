{
  "name": "vehicle-physics-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "tsc --noEmit && vite build",
    "verify": "npm run typecheck && npm run test:run && npm run build",
    "test:e2e": "playwright test",
    "measure": "tsx scripts/measure.ts"
  },
  "dependencies": { "three": "^0.180.0" },
  "devDependencies": {
    "@playwright/test": "^1.55.0", "@types/node": "^24.3.0", "@types/three": "^0.180.0",
    "typescript": "^5.9.2", "vite": "^7.1.3", "vitest": "^3.2.4", "tsx": "^4.20.5"
  }
}
