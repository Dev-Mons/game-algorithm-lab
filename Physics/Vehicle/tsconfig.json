{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node"]
  },
  "include": ["src", "tests", "scripts", "*.ts"]
}
