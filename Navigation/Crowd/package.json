{
  "name": "crowd-navigation-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.core.json --pretty false && tsc -p tsconfig.porting.json --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "measure": "vite-node scripts/measure.ts",
    "measure:long": "vite-node scripts/measure.ts --long",
    "measure:flows": "vite-node scripts/measure-flow-behavior.ts",
    "measure:quality": "vite-node scripts/measure-quality.ts",
    "measure:fluid": "vite-node scripts/measure-fluid.ts",
    "measure:lab": "vite-node scripts/measure-lab.ts",
    "measure:external": "vite-node scripts/measure-external.ts",
    "port:export": "vite-node scripts/port-export.ts",
    "port:verify": "vite-node scripts/port-verify.ts",
    "research:external": "vite-node scripts/compare-external-models.ts",
    "research:freeze": "vite-node scripts/measure-repair.ts --freeze --seeds=42,7,19,73",
    "research:repair": "vite-node scripts/measure-repair.ts",
    "research:audit": "vite-node scripts/check-repair-replays.ts",
    "verify": "npm run typecheck && npm run test:run && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
